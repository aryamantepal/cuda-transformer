        "## Update DecoderOnlyTransformer for Inference\n",
        "\n",
        "### Subtask:\n",
        "Refactor the `DecoderOnlyTransformer` class to support the updated `DecoderBlock` and handle both training and inference modes.\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "07d06315"
      },
      "source": [
        "**Reasoning**:\n",
        "I will redefine the DecoderOnlyTransformer class to support KV-caching in the forward method as specified in the instructions, allowing it to handle both standard training and cached inference.\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "7ddbdcfa",
        "outputId": "16dbd568-0100-417e-d35a-ffa1df512bfa"
      },
      "source": [
        "class DecoderOnlyTransformer(L.LightningModule):\n",
        "    def __init__(self, num_tokens=32000, d_model=512, num_heads=8,\n",
        "                 num_layers=6, d_ff=2048, max_len=512):\n",
        "        super().__init__()\n",
        "        L.seed_everything(seed=42)\n",
        "\n",
        "        self.we = nn.Embedding(num_tokens, d_model)\n",
        "        self.pe = PositionEncoding(d_model=d_model, max_len=max_len)\n",
        "        self.layers = nn.ModuleList([\n",
        "            DecoderBlock(d_model, num_heads, d_ff) for _ in range(num_layers)\n",
        "        ])\n",
        "        self.norm = nn.LayerNorm(d_model)\n",
        "        self.fc_layer = nn.Linear(d_model, num_tokens)\n",
        "        self.loss = nn.CrossEntropyLoss()\n",
        "\n",
        "    def forward(self, token_ids, kv_caches=None):\n",
        "        B, T = token_ids.shape\n",
        "        x = self.we(token_ids)\n",
        "        x = self.pe(x)\n",
        "\n",
        "        # During inference with KV cache, the sequence length might be 1 (for the new token),\n",
        "        # but the attention needs to look back at the full sequence.\n",
        "        # The causal mask should reflect the final sequence length or be handled by the attention layer.\n",
        "        # For simplicity, we generate the mask based on current input T.\n",
        "        mask = ~torch.tril(torch.ones(T, T, device=token_ids.device)).bool()\n",
        "\n",
        "        new_kv_caches = []\n",
        "        for i, layer in enumerate(self.layers):\n",
        "            cache = kv_caches[i] if kv_caches is not None else None\n",
        "            x, updated_cache = layer(x, mask=mask, kv_cache=cache)\n",
        "            new_kv_caches.append(updated_cache)\n",
        "\n",
        "        x = self.norm(x)\n",
        "        logits = self.fc_layer(x)\n",
        "\n",
        "        if kv_caches is not None:\n",
        "            return logits, new_kv_caches\n",
        "        return logits\n",
        "\n",
        "    def configure_optimizers(self):\n",
        "        return Adam(self.parameters(), lr=3e-4)\n",
        "\n",
        "    def training_step(self, batch, batch_idx):\n",
        "        input_tokens, labels = batch\n",
        "        logits = self.forward(input_tokens)\n",
        "        loss = self.loss(logits.view(-1, logits.size(-1)), labels.view(-1))\n",
        "        return loss\n",
        "\n",
        "print(\"DecoderOnlyTransformer refactored to support KV-caching.\")"
      ],
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "DecoderOnlyTransformer refactored to support KV-caching.\n"
          ]
        }
      ]
    },
